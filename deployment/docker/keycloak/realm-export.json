{
  "realm": "ecommerce-platform",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "bruteForceProtected": true,
  "accessTokenLifespan": 300,
  "roles": {
    "realm": [
      {
        "name": "ADMIN",
        "description": "Manages the catalogue, stock and payments"
      },
      {
        "name": "CUSTOMER",
        "description": "Places and reads own orders"
      },
      {
        "name": "SERVICE",
        "description": "Service-to-service calls (client credentials, FR-14)"
      }
    ]
  },
  "clients": [
    {
      "clientId": "api-gateway",
      "name": "API Gateway (public client for Postman, curl and k6)",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:8080/*"
      ],
      "webOrigins": [
        "+"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "tenant_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "tenant_id",
            "claim.name": "tenant_id",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "order-service",
      "name": "Order service (confidential, client credentials)",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${ORDER_SERVICE_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true
    }
  ],
  "users": [
    {
      "username": "admin",
      "enabled": true,
      "email": "admin@shop.local",
      "emailVerified": true,
      "firstName": "Platform",
      "lastName": "Admin",
      "credentials": [
        {
          "type": "password",
          "value": "${KC_TEST_USER_PASSWORD}",
          "temporary": false
        }
      ],
      "realmRoles": [
        "ADMIN"
      ],
      "attributes": {
        "tenant_id": [
          "tenant-a"
        ]
      }
    },
    {
      "username": "admin-b",
      "enabled": true,
      "email": "admin-b@shop.local",
      "emailVerified": true,
      "firstName": "Tenant B",
      "lastName": "Admin",
      "credentials": [
        {
          "type": "password",
          "value": "${KC_TEST_USER_PASSWORD}",
          "temporary": false
        }
      ],
      "realmRoles": [
        "ADMIN"
      ],
      "attributes": {
        "tenant_id": [
          "tenant-b"
        ]
      }
    },
    {
      "username": "customer1",
      "enabled": true,
      "email": "customer1@shop.local",
      "emailVerified": true,
      "firstName": "Customer",
      "lastName": "One",
      "credentials": [
        {
          "type": "password",
          "value": "${KC_TEST_USER_PASSWORD}",
          "temporary": false
        }
      ],
      "realmRoles": [
        "CUSTOMER"
      ],
      "attributes": {
        "tenant_id": [
          "tenant-a"
        ]
      }
    },
    {
      "username": "customer2",
      "enabled": true,
      "email": "customer2@shop.local",
      "emailVerified": true,
      "firstName": "Customer",
      "lastName": "Two",
      "credentials": [
        {
          "type": "password",
          "value": "${KC_TEST_USER_PASSWORD}",
          "temporary": false
        }
      ],
      "realmRoles": [
        "CUSTOMER"
      ],
      "attributes": {
        "tenant_id": [
          "tenant-b"
        ]
      }
    },
    {
      "username": "service-account-order-service",
      "enabled": true,
      "serviceAccountClientId": "order-service",
      "realmRoles": [
        "SERVICE"
      ]
    }
  ],
  "components": {
    "org.keycloak.userprofile.UserProfileProvider": [
      {
        "providerId": "declarative-user-profile",
        "subComponents": {},
        "config": {
          "kc.user.profile.config": [
            "{\"attributes\": [{\"name\": \"username\", \"validations\": {\"length\": {\"min\": 3, \"max\": 255}, \"username-prohibited-characters\": {}, \"up-username-not-idn-homograph\": {}}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}, \"multivalued\": false}, {\"name\": \"email\", \"validations\": {\"email\": {}, \"length\": {\"max\": 255}}, \"required\": {\"roles\": [\"user\"]}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}, \"multivalued\": false}, {\"name\": \"firstName\", \"validations\": {\"length\": {\"max\": 255}, \"person-name-prohibited-characters\": {}}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}, \"multivalued\": false}, {\"name\": \"lastName\", \"validations\": {\"length\": {\"max\": 255}, \"person-name-prohibited-characters\": {}}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}, \"multivalued\": false}, {\"name\": \"tenant_id\", \"displayName\": \"Tenant (Bonus B3)\", \"validations\": {\"options\": {\"options\": [\"tenant-a\", \"tenant-b\"]}}, \"permissions\": {\"view\": [\"admin\"], \"edit\": [\"admin\"]}, \"multivalued\": false}], \"groups\": [{\"name\": \"user-metadata\", \"displayHeader\": \"User metadata\", \"displayDescription\": \"Attributes, which refer to user metadata\"}]}"
          ]
        }
      }
    ]
  }
}
