# Copy to .env (git-ignored) and replace every change-me value before `docker compose up`.
# scripts/create-k8s-secrets.sh reads the same file to create the Kubernetes Secrets.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# 0.0 = payments never fail, 1.0 = every payment fails (compensation demo)
PAYMENT_FAILURE_RATE=0.0

# Host ports for the two ports most often taken on a developer machine
GATEWAY_HOST_PORT=8080
POSTGRES_HOST_PORT=5432

# Optional: pull private images from GHCR inside the kind cluster
GHCR_USERNAME=
GHCR_TOKEN=
