# Copy to .env (git-ignored) and replace every value. Never commit .env (NFR-04).

# PostgreSQL superuser (used only by the init script)
POSTGRES_PASSWORD=change-me
# One login per service database: product_user, inventory_user, order_user, payment_user
PRODUCT_DB_PASSWORD=change-me
INVENTORY_DB_PASSWORD=change-me
ORDER_DB_PASSWORD=change-me
PAYMENT_DB_PASSWORD=change-me

# Keycloak bootstrap admin (console at http://localhost:8180)
KEYCLOAK_ADMIN_PASSWORD=change-me
# Password of the realm test users admin / customer1 / customer2
KC_TEST_USER_PASSWORD=change-me
# Client secret of the confidential client order-service (FR-14 client credentials)
ORDER_SERVICE_CLIENT_SECRET=change-me

# Grafana admin
GRAFANA_ADMIN_PASSWORD=change-me

# Optional: gateway rate limit per client (defaults 20 req/s, burst 40). Raise only for k6 load tests.
# GATEWAY_RATE_LIMIT_REPLENISH_RATE=1000
# GATEWAY_RATE_LIMIT_BURST_CAPACITY=2000

# Optional: host port of the compose PostgreSQL when 5432 is taken by a local install (services read it too)
# POSTGRES_PORT=5433
